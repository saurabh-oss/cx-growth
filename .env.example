# ══════════════════════════════════════════
#  Growth Engine POC — Environment Config
# ══════════════════════════════════════════
# The app reads these from the environment. It does not load this file —
# set them in the shell before running run.bat:   set NAME=value

# Anthropic API key (optional). With it, Claude reads each conversation and its
# analysis is layered over the engine's. Without it everything still works.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Which customer platform holds the profiles.
#   local   built-in store (default)
#   unomi   Apache Unomi — start it first:  cd platform && docker compose up -d
#   auto    Unomi if it answers, otherwise the built-in store
#   vendor  the vendor's own platform — needs the XP_* settings and a sandbox (see backend/cdp.py)
CUSTOMER_PLATFORM=local

# Apache Unomi. These are its defaults; change them if you change the container.
UNOMI_URL=http://127.0.0.1:8181
UNOMI_USER=karaf
UNOMI_PASSWORD=karaf

# Port the app listens on.
PORT=8000